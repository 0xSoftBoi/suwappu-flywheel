{
  "name": "suwappu-flywheel",
  "version": "2.0.0",
  "private": true,
  "description": "Standalone Suwappu strategy-operations product with paper-first workflows and outcome-safe managed execution",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": { "suwappu-flywheel": "src/cli.ts", "flywheel-tui": "src/tui.ts" },
  "scripts": {
    "start": "bun run src/cli.ts run",
    "yield": "bun run src/cli.ts yield",
    "dca": "bun run src/cli.ts dca",
    "arb": "bun run src/cli.ts arb",
    "predict": "bun run src/cli.ts predict",
    "status": "bun run src/cli.ts status",
    "tui": "bun run src/tui.ts",
    "scalp": "bun run src/scalper.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts src/tui.ts src/scalper.ts --target=bun --outdir=dist",
    "verify": "bun run check && bun test && bun run build && bun audit --audit-level=high"
  },
  "dependencies": {
    "@suwappu/sdk": "^0.4.0",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.0.0"
  },
  "engines": { "bun": ">=1.3.14" },
  "license": "MIT"
}
