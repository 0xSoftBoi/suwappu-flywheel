SUWAPPU_API_KEY=suwappu_sk_your_api_key_here
# Optional: override the API host for local/staging development.
# SUWAPPU_API_URL=https://api.suwappu.bot

# Optional: address to monitor for portfolio/balance checks.
# Live --execute commands use the managed wallet associated with SUWAPPU_API_KEY;
# this value is never treated as a signing key or execution wallet.
# WALLET_ADDRESS=0xYourWalletAddress

# Optional: the actual Suwappu-managed wallet address. When provided, live
# quote simulation can run wallet-dependent balance/allowance/gas checks.
# SUWAPPU_MANAGED_WALLET_ADDRESS=0xManagedWalletAddress

# Optional live DCA cap (USDC). Defaults to 1000 when unset.
# SUWAPPU_MAX_TRADE_USD=1000

# Optional scalper strategy budget. Kelly percentage sizing is applied only
# when this real operator-defined budget exists; Flywheel never guesses it.
# SUWAPPU_SCALPER_USDC_BUDGET=100

# Managed REST operation deadline in milliseconds. Defaults to 25000 and must
# stay between 100 and 30000.
# SUWAPPU_OPERATION_TIMEOUT_MS=25000

# Emit metadata-only Suwappu API operation events to stderr (no bodies/IDs/secrets).
# SUWAPPU_API_EVENTS=1

# Optional: relocate Flywheel's local strategy/execution state.
# SUWAPPU_FLYWHEEL_STATE_DIR=/path/to/state
